{
  "name": "@streamerson/benchmarking",
  "version": "0.0.1",
  "module": "CommonJS",
  "scripts": {
    "run-benchmark": "STREAMERSON_BENCHMARK_FILE_TARGET=benchmark tools/start-benchmark.sh bun",
    "run-loadtest": "tools/start-loadtest.sh",
    "build:summary": "bun ./tools/summarizeResults.ts --write",
    "import:gcp": "cd ./deploy/gcp && GOOGLE_APPLICATION_CREDENTIALS=key.gcp.json ./import import google --regions=us-central1 --projects=streamerson-benchmarks --resources=*",
    "build": "tsc -b tsconfig.lib.json"
  },
  "dependencies": {
    "@streamerson/consumer": "workspace:*",
    "@streamerson/core": "workspace:*",
    "@streamerson/gateway-fastify": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "glob": "^13.0.6",
    "markdown-table-ts": "^1.0.3",
    "minimist": "^1.2.8",
    "pino": "^10.3.1",
    "redis": "^6.2.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.2"
  }
}
