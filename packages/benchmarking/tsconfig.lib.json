{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/packages/benchmarking",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "../../dist/packages/benchmarking/.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../core/tsconfig.lib.json"
    },
    {
      "path": "../consumer/tsconfig.lib.json"
    },
    {
      "path": "../gateway-fastify/tsconfig.lib.json"
    }
  ]
}
