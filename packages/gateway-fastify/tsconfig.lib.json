{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/packages/gateway-fastify",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "../../dist/packages/gateway-fastify/.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../core/tsconfig.lib.json"
    }
  ]
}
